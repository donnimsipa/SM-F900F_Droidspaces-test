#
# Custom kernel configuration for SM-F900F Z Fold 1st Gen
# This file overrides settings from winnerlte_eur_open_defconfig
#

#
# Disable Samsung anti-root / security features
# These prevent root access and must be disabled for KernelSU-Next
#
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_FIVE=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n

#
# DTB and build configuration
#
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_IMG_DTB=y
CONFIG_LOCALVERSION="ZFold-KSUN@donnimsipa"
CONFIG_LOCALVERSION_AUTO=n

# KernelSU-Next
CONFIG_KSU=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
CONFIG_KSU_MANUAL_HOOK=y
